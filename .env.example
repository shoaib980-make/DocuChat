# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_anon_key
SUPABASE_SECRET_KEY=your_service_role_secret_key

# Vector Store Backend: 'supabase' (default) or 'faiss' (local fallback)
VECTOR_STORE_BACKEND=supabase

# LLM Configuration (Optional: defaults to built-in deterministic grounded generator if omitted)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
